{
  "$defs": {
    "Awaiting": {
      "additionalProperties": false,
      "description": "Targets that only an enrichment (the second pass) can bring.",
      "properties": {
        "family": {
          "enum": [
            "low_cardinality",
            "structured_string",
            "numeric",
            "date",
            "quality",
            "relations"
          ],
          "title": "Family",
          "type": "string"
        },
        "analyzer": {
          "title": "Analyzer",
          "type": "string"
        },
        "analyses": {
          "title": "Analyses",
          "type": "integer"
        }
      },
      "required": [
        "family",
        "analyzer",
        "analyses"
      ],
      "title": "Awaiting",
      "type": "object"
    },
    "CandidateBudget": {
      "additionalProperties": false,
      "description": "The candidate rows the selection would hold in memory: a few per target\nand the reserve. ``bytes_expected`` counts the rows as source text (the mean\nrow size of the source), not the memory of the process; ``fits`` says whether\nit stays within ``budget_bytes``. When it does not, ``per_target_effective``\nis the number of candidates per target the budget allows, at least one.",
      "properties": {
        "per_target": {
          "title": "Per Target",
          "type": "integer"
        },
        "per_target_effective": {
          "title": "Per Target Effective",
          "type": "integer"
        },
        "rows": {
          "title": "Rows",
          "type": "integer"
        },
        "row_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Bytes"
        },
        "bytes_expected": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes Expected"
        },
        "budget_bytes": {
          "title": "Budget Bytes",
          "type": "integer"
        },
        "fits": {
          "title": "Fits",
          "type": "boolean"
        }
      },
      "required": [
        "per_target",
        "per_target_effective",
        "rows",
        "budget_bytes",
        "fits"
      ],
      "title": "CandidateBudget",
      "type": "object"
    },
    "Catalog": {
      "additionalProperties": false,
      "description": "What the targets of one family say about one column: whether they list\nevery value it can take (E09) or only the ones the Scan saw (E12).",
      "properties": {
        "family": {
          "enum": [
            "low_cardinality",
            "structured_string",
            "numeric",
            "date",
            "quality",
            "relations"
          ],
          "title": "Family",
          "type": "string"
        },
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "guarantee": {
          "enum": [
            "catalog_complete",
            "known_values_only",
            "none"
          ],
          "title": "Guarantee",
          "type": "string"
        },
        "targets": {
          "title": "Targets",
          "type": "integer"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "family",
        "dataset",
        "field",
        "display",
        "complete",
        "guarantee",
        "targets",
        "reasons"
      ],
      "title": "Catalog",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "What the sample covers of the catalog of targets of the plan (SMART-12).\n\n``scope`` names it: the targets of the plan, not every phenomenon of the data\n(SMART-13). ``evaluable`` leaves out the targets the sample could not test.",
      "properties": {
        "scope": {
          "const": "target_catalog",
          "default": "target_catalog",
          "title": "Scope",
          "type": "string"
        },
        "defined": {
          "title": "Defined",
          "type": "integer"
        },
        "evaluable": {
          "title": "Evaluable",
          "type": "integer"
        },
        "observed": {
          "title": "Observed",
          "type": "integer"
        },
        "covered": {
          "title": "Covered",
          "type": "integer"
        },
        "weighted": {
          "$ref": "#/$defs/Weighted"
        },
        "mandatory": {
          "$ref": "#/$defs/MandatoryCoverage"
        },
        "families": {
          "items": {
            "$ref": "#/$defs/FamilyCoverage"
          },
          "title": "Families",
          "type": "array"
        },
        "missing": {
          "items": {
            "$ref": "#/$defs/Missing"
          },
          "title": "Missing",
          "type": "array"
        },
        "missing_total": {
          "title": "Missing Total",
          "type": "integer"
        },
        "verification": {
          "$ref": "#/$defs/Verification"
        }
      },
      "required": [
        "defined",
        "evaluable",
        "observed",
        "covered",
        "weighted",
        "mandatory",
        "families",
        "missing",
        "missing_total",
        "verification"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "CsvSourceInfo": {
