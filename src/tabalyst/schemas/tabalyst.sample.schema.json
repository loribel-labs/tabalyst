    "SmartBaseWeights": {
      "additionalProperties": false,
      "description": "The base weight of each kind of target (design 20.15). A weight grows\nwith its base and with the rarity of what the target stands for, up to\n``SmartWeights.cap``.",
      "properties": {
        "confirmed_issue": {
          "default": 10.0,
          "minimum": 0,
          "title": "Confirmed Issue",
          "type": "number"
        },
        "candidate_anomaly": {
          "default": 6.0,
          "minimum": 0,
          "title": "Candidate Anomaly",
          "type": "number"
        },
        "value": {
          "default": 5.0,
          "minimum": 0,
          "title": "Value",
          "type": "number"
