          "type": "string"
        },
        "used": {
          "title": "Used",
          "type": "integer"
        },
        "requested": {
          "title": "Requested",
          "type": "boolean"
        },
        "awaiting": {
          "items": {
            "$ref": "#/$defs/Awaiting"
          },
          "title": "Awaiting",
          "type": "array"
        }
      },
      "required": [
        "deep",
        "used",
        "requested",
        "awaiting"
      ],
      "title": "Enrichment",
      "type": "object"
    },
    "ExcelSourceInfo": {
      "additionalProperties": false,
