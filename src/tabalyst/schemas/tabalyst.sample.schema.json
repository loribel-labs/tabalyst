    "Enrichment": {
      "additionalProperties": false,
      "description": "The state of the second-pass document the targets may stand on.\n``requested`` says that a second pass was asked for before the sample;\n``awaiting`` is then what it would add.",
      "properties": {
        "deep": {
          "enum": [
            "current",
            "stale",
            "absent"
