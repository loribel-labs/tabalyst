    "Sizes": {
      "additionalProperties": false,
      "description": "The sizes of the sample. ``mandatory_bound`` is the number of mandatory\ntargets the Scan can evaluate: one row each is always enough, and rows that\ncover several targets need fewer. ``useful_maximum`` is the size beyond\nwhich the reserve would be the only thing added; ``records`` the rows of the\ndataset.",
      "properties": {
        "requested": {
          "anyOf": [
