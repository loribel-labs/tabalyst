          "type": "number"
        },
        "signal": {
          "default": 3.0,
          "minimum": 0,
          "title": "Signal",
          "type": "number"
        },
        "bin": {
          "default": 2.0,
          "minimum": 0,
          "title": "Bin",
          "type": "number"
        }
      },
      "title": "SmartBaseWeights",
      "type": "object"
    },
    "SmartSettings": {
      "additionalProperties": false,
      "description": "How the plan of a smart sample defines its targets (design 20.15).\n\nA column of at most ``max_enum_values`` distinct values gets one target per\nvalue; a numeric column is cut into ``numeric_bins`` bins of equal width\nbetween its minimum and maximum. The plan keeps ``candidates_per_target`` rows\nper target in memory at most, in ``max_candidate_bytes`` bytes, and\n``reserve_share`` of the rows asked for are a reserve of ordinary rows. At\nmost ``max_targets`` targets are kept, the heaviest first.",
      "properties": {
        "max_enum_values": {
          "default": 100,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Enum Values",
          "type": "integer"
        },
        "numeric_bins": {
          "default": 10,
          "maximum": 100,
          "minimum": 2,
          "title": "Numeric Bins",
          "type": "integer"
        },
        "candidates_per_target": {
          "default": 2,
          "maximum": 3,
          "minimum": 1,
          "title": "Candidates Per Target",
          "type": "integer"
        },
        "reserve_share": {
          "default": 0.2,
          "maximum": 0.9,
          "minimum": 0,
          "title": "Reserve Share",
          "type": "number"
        },
        "max_targets": {
          "default": 10000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Targets",
          "type": "integer"
        },
        "max_candidate_bytes": {
          "default": 67108864,
          "minimum": 1,
          "title": "Max Candidate Bytes",
          "type": "integer"
        },
        "weights": {
          "$ref": "#/$defs/SmartWeights"
        }
      },
      "title": "SmartSettings",
      "type": "object"
    },
    "SmartWeights": {
      "additionalProperties": false,
      "description": "The weight of a target: ``min(cap, base * (1 + gain * rarity))``, where\n``rarity`` goes from 0 (the target covers every row) to 1 (it covers a share\nof ``floor`` rows or less) and is ``unknown_rarity`` when the frequency of\nthe target is not known. Monotone in the share and in the base.",
      "properties": {
        "base": {
          "$ref": "#/$defs/SmartBaseWeights"
        },
        "gain": {
          "default": 1.0,
          "minimum": 0,
          "title": "Gain",
          "type": "number"
        },
        "floor": {
          "default": 1e-06,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Floor",
          "type": "number"
        },
        "cap": {
          "default": 20.0,
          "exclusiveMinimum": 0,
          "title": "Cap",
          "type": "number"
        },
        "unknown_rarity": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Unknown Rarity",
          "type": "number"
        }
      },
      "title": "SmartWeights",
      "type": "object"
    },
