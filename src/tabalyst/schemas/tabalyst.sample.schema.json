    "Predicate": {
      "additionalProperties": false,
      "description": "What makes a row cover a target, as a kind and the references that fix it\n(a sampled entry, a pattern, a bin). ``source`` is where the references\npoint: the Scan, or the second-pass document. Never a value of the data.",
      "properties": {
        "kind": {
          "enum": [
            "value_equals",
            "value_missing",
            "pattern_matches",
            "pattern_other",
            "length_min",
            "length_max",
            "numeric_min",
            "numeric_max",
            "numeric_zero",
            "numeric_sign",
            "numeric_bin",
            "date_min",
            "date_max",
            "date_kind",
            "date_year",
            "observation",
            "relation_exception"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "source": {
          "default": "scan",
          "enum": [
            "scan",
            "second_pass"
          ],
          "title": "Source",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Predicate",
      "type": "object"
    },
