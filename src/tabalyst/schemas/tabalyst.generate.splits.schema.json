          "type": "integer"
        },
        "client_leakage_cases": {
          "default": 0,
          "minimum": 0,
          "title": "Client Leakage Cases",
          "type": "integer"
        },
        "resampled_train_rows": {
          "default": 0,
          "minimum": 0,
          "title": "Resampled Train Rows",
          "type": "integer"
        },
        "temporal_cutoffs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Temporal Cutoffs",
          "type": "object"
        }
      },
      "title": "SplitMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Document tabalyst.generate.splits, format 0.2.0 revision 1: the dataset partitioning and leakage prevention specification.",
