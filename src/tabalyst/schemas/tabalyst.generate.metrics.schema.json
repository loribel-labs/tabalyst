        },
        "resampled_train_rows": {
          "default": 0,
          "minimum": 0,
          "title": "Resampled Train Rows",
          "type": "integer"
        },
        "temporal_cutoffs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Temporal Cutoffs",
          "type": "object"
        }
      },
      "title": "SplitMetrics",
      "type": "object"
    },
    "TemporalDriftMetrics": {
      "additionalProperties": false,
      "description": "Aggregate metrics on temporal rule validity, periods, and drift scenarios.",
      "properties": {
        "active_periods": {
          "items": {
            "type": "string"
          },
          "title": "Active Periods",
          "type": "array"
        },
        "drift_scenarios": {
          "items": {
            "type": "string"
          },
          "title": "Drift Scenarios",
          "type": "array"
        },
        "temporal_rules": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Temporal Rules",
          "type": "object"
        }
      },
      "title": "TemporalDriftMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Document tabalyst.generate.metrics, format 0.2.0 revision 1: the exact counts of a scenario profile's run.",
  "properties": {
    "format": {
      "const": "tabalyst.generate.metrics",
      "default": "tabalyst.generate.metrics",
      "title": "Format",
      "type": "string"
    },
    "format_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Format Version",
      "type": "string"
    },
    "format_revision": {
      "const": 1,
      "default": 1,
      "title": "Format Revision",
      "type": "integer"
    },
    "dataset": {
      "title": "Dataset",
      "type": "string"
    },
    "profile": {
      "title": "Profile",
      "type": "string"
    },
    "rows": {
      "$ref": "#/$defs/Rows"
    },
    "counts": {
      "$ref": "#/$defs/Counts"
    },
    "scenarios": {
      "additionalProperties": {
        "$ref": "#/$defs/ScenarioMetrics"
      },
      "title": "Scenarios",
      "type": "object"
    },
    "rules": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Rules",
      "type": "object"
    },
    "categories": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Categories",
      "type": "object"
    },
    "kinds": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Kinds",
      "type": "object"
    },
    "absence_probability": {
      "additionalProperties": {
        "$ref": "#/$defs/AbsenceProbability"
      },
      "title": "Absence Probability",
      "type": "object"
    },
    "root_causes": {
      "additionalProperties": {
        "$ref": "#/$defs/RootCauseMetrics"
      },
      "title": "Root Causes",
      "type": "object"
    },
    "missing_data": {
      "$ref": "#/$defs/MissingDataMetrics"
    },
    "temporal_drift": {
      "$ref": "#/$defs/TemporalDriftMetrics"
    },
    "ml_fraud": {
      "$ref": "#/$defs/MLFraudMetrics"
    },
    "splits": {
      "$ref": "#/$defs/SplitMetrics"
    },
    "latent": {
