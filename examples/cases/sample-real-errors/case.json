{
  "id": "sample-real-errors",
  "title": "Defects kept by a sample of a large file",
  "tool": "sample",
  "question": "When a 100,000-row file holds defects of 45 kinds, a few rows each, how many kinds does a sample of 3,000 or 300 rows keep?",
  "inputs": {
    "source": "../../datasets/insurance-customers-100k.json",
    "dirty": "generated by examples/tools/make_datasets.py outside the checkout",
    "truth": "input/truth.json"
  },
  "build": {
    "script": "case.py",
    "seed": 20260916
  },
  "runs": {
    "smart": {
      "args": [
        "--smart",
        "--yes",
        "--no-html"
      ],
      "seeds": [
        1,
        2,
        3
      ]
    },
    "random": {
      "args": [
        "--sample-method",
        "random"
      ],
      "seeds": [
        1,
        2,
        3
      ]
    }
  },
  "measure": {
    "sizes": [
      3000,
      300
    ],
    "unit": "share of runs that keep at least one row of the class"
  },
  "expectations": {
    "run": "smart",
    "rows": 3000,
    "seed": 1,
    "kept": [
      "code_postal_double_space",
      "id_contrat_empty",
      "province_code_lower",
      "date_other_branch_format",
      "agence_code_double_hyphen",
      "ville_typo",
      "nom_voie_typo",
      "id_client_double_hyphen",
      "claim_amount_negative",
      "prenom_typo",
      "duplicate_rows",
      "nom_typo",
      "type_contrat_variant",
      "province_nom_lower",
      "province_code_empty",
      "name_double_space",
      "prime_annuelle_negative",
      "telephone_double_space",
      "category_suffix_x",
      "id_contrat_missing_digit",
      "id_client_missing_digit",
      "id_contrat_double_hyphen",
      "prime_annuelle_currency_prefix",
      "pays_code_lower",
      "date_start_after_end",
      "date_fin_sentinel",
      "date_naissance_empty",
      "mode_paiement_accent_removed",
      "claim_amount_zero",
      "prime_annuelle_text",
      "prenom_empty",
      "code_postal_char_missing",
      "nom_empty",
      "type_contrat_empty",
      "nom_voie_very_long",
      "courriel_space_inside",
      "date_slash",
      "prime_annuelle_currency_code",
      "name_space_inside",
      "prime_annuelle_currency_suffix",
      "ville_space_inside",
      "prime_annuelle_currency_fr",
      "city_mojibake",
      "nom_leading_apostrophe"
    ],
    "gaps": [
      {
        "class": "province_code_city_mismatch",
        "reason": "3 rows whose province is valid but wrong for the city: a combination of two columns, the target of lot S3"
      }
    ]
  },
  "publish": {
    "site": false,
    "docs": []
  },
  "captures": []
}
