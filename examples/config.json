{
  "preview_rows": 20,
  "string_analysis": {
    "very_short_max_length": 5,
    "short_max_length": 20,
    "medium_max_length": 50,
    "long_max_length": 255,
    "length_distribution_max_length": 50,
    "examples_per_length": 10
  },
  "value_examples": {
    "full_distribution_max_distinct": 50,
    "short_text_max_length": 20,
    "short_text_percentile": 0.95,
    "short_text_result_size": 20,
    "long_text_result_size": 20,
    "long_text_truncate_at": 30,
    "truncation_suffix": "...",
    "inline_display_size": 3
  },
  "scan": {
    "csv": {
      "encoding": "utf-8-sig",
      "delimiter": ","
    },
    "values": {
      "null_markers": ["N/A", "NULL"],
      "missing": ["absent", "null", "empty", "blank", "marker"]
    },
    "normalization": {
      "trim": true,
      "collapse_whitespace": true
    },
    "types": {
      "minimum_confidence": 0.95
    },
    "detectors": {
      "date": {
        "orders": ["YMD", "MDY", "DMY"],
        "separators": ["-", "/", "."],
        "ambiguous_order": null
      },
      "enumeration": {
        "minimum_values": 500,
        "maximum_distinct": 49,
        "case_sensitive": true
      }
    },
    "limits": {
      "max_samples": 100
    },
    "exposure": {
      "sensitive_values": "mask"
    },
    "random_seed": 42
  }
}
